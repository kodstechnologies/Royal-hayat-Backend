INTERNATIONAL_PATIENT_ENQUIRY_NOTIFICATION_EMAILS=info@royalehayat.com,marketing@royalehayat.com
AL_SAFWA_ENROLLMENT_NOTIFICATION_TO=justine.talampas@royalehayat.com,shehab.mahdy@royalehayat.com,rima.chendeb@royalehayat.com

AL_SAFWA_ENROLLMENT_NOTIFICATION_CC=marketing@royalehayat.com
EVENT_BOOKING_NOTIFICATION_EMAILS=events@royalehayat.com,rola.boufalgha@royalehayat.com,rosemary.creer@royalehayat.com,marketing@royalehayat.com
OTP_EXPIRY_MINUTES=10

ADMIN_SEED_PASSWORD=change_me

ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

CORS_ORIGIN=http://localhost:8080,http://localhost:8081

SHARPER_BASE_URL=https://mid.royalehayat.com/p/xapi/
SHARPER_API_KEY=
SHARPER_USER=
SHARPER_PASS=
SHARPER_CALLBACK_URL=http://localhost:8000/api/callback

IDENTITY_START_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_START_RATE_LIMIT_MAX=5
IDENTITY_STATUS_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_STATUS_RATE_LIMIT_MAX=30

ROYAL_HAYAT_BASE_URL=https://rhhtrakapi.royalehayat.com

# Public website origin for document links (no trailing slash)
# Production: https://www.royalehayat.com
# Local RoyalHayat dev: http://localhost:8080
PUBLIC_SITE_URL=https://www.royalehayat.com
ROYAL_HAYAT_USERNAME=
ROYAL_HAYAT_PASSWORD=
ROYAL_HAYAT_API_KEY=

ROYAL_HAYAT_AUTH_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_AUTH_RATE_LIMIT_MAX=5
ROYAL_HAYAT_AVAILABILITY_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_AVAILABILITY_RATE_LIMIT_MAX=20
ROYAL_HAYAT_BOOKING_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_BOOKING_RATE_LIMIT_MAX=10
ROYAL_HAYAT_GENERAL_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_GENERAL_RATE_LIMIT_MAX=30

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemini-flash-latest
CHAT_MODEL_RETRY_DELAY_MS=400
GEMINI_CHAT_TEMPERATURE=0.6
GEMINI_CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_MAX_HISTORY_TURNS=16
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=30
CHAT_GROUNDING_CACHE_TTL_MS=600000
CHAT_GROUNDING_MAX_DEPARTMENTS=60
CHAT_GROUNDING_DEPT_DESC_MAX=160
CHAT_LOG_ENABLED=true
CHAT_LOG_TO_CONSOLE=false
CHAT_LOG_MAX_CHARS=8000
