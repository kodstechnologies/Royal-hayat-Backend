# Database Configuration
MONGODB_URI=mongodb://localhost:27017/royale-hayat

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server Configuration
PORT=8000
NODE_ENV=development
# Trust reverse proxy for client IP (1 = single nginx/ALB hop). Set false for local-only, no proxy.
TRUST_PROXY=1

# Identity API rate limits
IDENTITY_START_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_START_RATE_LIMIT_MAX=5
IDENTITY_STATUS_RATE_LIMIT_WINDOW_MS=60000
IDENTITY_STATUS_RATE_LIMIT_MAX=30

# Royal Hayat Integration
ROYAL_HAYAT_BASE_URL=https://rhkw-testtrak.royalehayat.com
ROYAL_HAYAT_USERNAME=your_username
ROYAL_HAYAT_PASSWORD=your_password
ROYAL_HAYAT_API_KEY=L9Ip89jLlVj730p69JizytfWf006A1D1uRcV684v

# Royal Hayat API rate limits
ROYAL_HAYAT_AUTH_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_AUTH_RATE_LIMIT_MAX=5
ROYAL_HAYAT_AVAILABILITY_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_AVAILABILITY_RATE_LIMIT_MAX=20
ROYAL_HAYAT_BOOKING_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_BOOKING_RATE_LIMIT_MAX=10
ROYAL_HAYAT_GENERAL_RATE_LIMIT_WINDOW_MS=60000
ROYAL_HAYAT_GENERAL_RATE_LIMIT_MAX=30
