# Copy to .env for local development, or .env.production for production reference.
# On EC2, deploy uses GitHub secret ENV_FILE → .env (see .github/workflows/deploy.yml).

PORT=8000
NODE_ENV=development
TRUST_PROXY=1

MONGODB_URI=mongodb://localhost:27017/royal-hayat
DB_NAME=royal-hayat

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

AWS_BUCKET_NAME=your_bucket
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Royal Hayat <royalehayat.dev@gmail.com>"
JOB_APPLICANT_MAIL_FROM="Royale Hayat <noreply@royalehayat.com>"
JOB_APPLICANT_SMTP_HOST=smtp.siteprotect.com
JOB_APPLICANT_SMTP_PORT=587
JOB_APPLICANT_SMTP_SECURE=false
JOB_APPLICANT_SMTP_USER=noreply@royalehayat.com
JOB_APPLICANT_SMTP_PASS=
